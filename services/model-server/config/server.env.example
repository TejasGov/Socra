# vLLM model server config. Copy to server.env (git-ignored) and fill in.
# Only the backend calls this service; keep the API key secret.
MODEL_SERVER_API_KEY=
MODEL_NAME=google/gemma-3-4b-it
MODEL_VERSION=socra-gemma-3-4b-v1
HUGGINGFACE_TOKEN=
PORT=8001
# vLLM tuning
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.90
