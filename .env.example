# =============================================================
# Socra — Example environment file
# -------------------------------------------------------------
# Copy this file, DO NOT put real secrets here.
#   Root:     cp .env.example .env
#   Frontend: cp .env.example apps/web/.env.local   (frontend-safe vars only)
#   Backend:  cp .env.example services/api/.env      (backend-only vars)
#
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser bundle.
# Everything else is BACKEND-ONLY and must never reach the frontend.
# =============================================================

# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
APP_ENV=development                       # development | staging | production
NEXT_PUBLIC_APP_ENV=development

# ---------------------------------------------------------------
# Frontend  (safe to expose — apps/web/.env.local)
# ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ACP bring-your-own-subscription bridge. Localhost WebSocket exposed by
# `npx socra-bridge` (packages/acp-bridge) running on the student's own
# machine — never a public URL. See docs/acp-integration.md.
NEXT_PUBLIC_ACP_BRIDGE_URL=ws://127.0.0.1:8137

# ---------------------------------------------------------------
# Supabase  (BACKEND — services/api/.env)
# SUPABASE_SERVICE_ROLE_KEY must NEVER be exposed to the browser.
# ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Database  (BACKEND)
# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# ---------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------
# Model server / vLLM  (BACKEND)
# The frontend must NEVER call the model server directly.
# ---------------------------------------------------------------
MODEL_SERVER_URL=http://localhost:8001
MODEL_SERVER_API_KEY=
MODEL_NAME=google/gemma-4-E4B-it
MODEL_VERSION=socra-gemma-4-E4B-v1

# ---------------------------------------------------------------
# Embeddings  (BACKEND)
# ---------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---------------------------------------------------------------
# Hugging Face  (BACKEND / TRAINING ONLY — never frontend)
# ---------------------------------------------------------------
HUGGINGFACE_TOKEN=

# ---------------------------------------------------------------
# CORS / security  (BACKEND)
# ---------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000
